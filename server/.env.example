# ╔══════════════════════════════════════════════════╗
# ║   Smart Placement Tracker — Environment Config   ║
# ║   Copy to .env and fill in real values            ║
# ╚══════════════════════════════════════════════════╝

# ── App ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:8080,https://campus-careers-mate.vercel.app

# ── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_tracker?schema=public

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRY=7d

# ── Rate Limiting ─────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Logging ───────────────────────────────────────
r
