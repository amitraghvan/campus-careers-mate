# ╔══════════════════════════════════════════════════╗
# ║   Campus Careers Mate — Backend Environment      ║
# ║   Copy to .env and fill with real values         ║
# ╚══════════════════════════════════════════════════╝
# ⚠️  NEVER commit .env files to version control!
# ⚠️  Use AWS Secrets Manager, HashiCorp Vault, or Doppler in production

# ── App Configuration ────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# ── CORS Configuration ───────────────────────────
# Comma-separated list of allowed origins (no wildcards!)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ── Database (PostgreSQL) ─────────────────────────
# Connection pooling recommended for production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_careers
DB_USER=
DB_PASSWORD=
DB_SSL_MODE=require
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_QUERY_TIMEOUT=10000

# ── Redis Configuration ─────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
REDIS_KEY_PREFIX=ccm:

# ── JWT Security (Generate strong keys!) ──────────
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=campus-careers-mate
JWT_AUDIENCE=campus-careers-api

# ── Encryption (32-byte hex for field encryption) ─
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── External APIs ─────────────────────────────────
# Store these in secrets manager in production!
GROQ_API_KEY=

# ── Clerk Authentication ──────────────────────────
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Rate Limiting ──────────────────────────────────
# General API: 100 requests per minute
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Auth endpoints: 5 attempts per 5 minutes
AUTH_THROTTLE_TTL=300000
AUTH_THROTTLE_LIMIT=5

# AI endpoints: 10 requests per minute
AI_THROTTLE_TTL=60000
AI_THROTTLE_LIMIT=10

# ── File Upload Security ──────────────────────────
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf
UPLOAD_DIR=uploads

# ── Logging & Monitoring ──────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true

# Sentry for error tracking
SENTRY_DSN=

# ── Security Headers ─────────────────────────────
CSP_REPORT_ONLY=false
HSTS_MAX_AGE=31536000
