# ╔══════════════════════════════════════════════════╗
# ║   Campus Careers Mate — Frontend Environment     ║
# ║   Copy to .env and fill with real values         ║
# ╚══════════════════════════════════════════════════╝
# ⚠️  NEVER commit .env files to version control!

# ── API Configuration ──────────────────────────────
# Backend API URL (no trailing slash).
# ‼️  REQUIRED on Vercel: set this to your deployed backend URL
#    e.g. https://your-backend.railway.app
# All AI features (Homework Solver, Mock Exams, Code Explainer,
# Study Planner) route through the backend — no Groq key needed here.
VITE_API_URL=http://localhost:3000

# ── Clerk Authentication ─────────────────────────
# Get from https://dashboard.clerk.com
# ‼️  REQUIRED on Vercel: must also be set as a Vercel env var
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Feature Flags ─────────────────────────────────
VITE_ENABLE_ANALYTICS=false
VITE_SENTRY_DSN=
